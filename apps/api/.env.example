PORT=3000

# Base de datos local dockerizada del repo (nunca Supabase)
# En Compose: postgresql://plancity:plancity@db:5432/plancity
# En local contra Compose: postgresql://plancity:plancity@localhost:5432/plancity
DATABASE_URL=postgresql://plancity:plancity@localhost:5432/plancity

# JWT
JWT_SECRET=cambia-este-valor-por-uno-generado-aleatoriamente
JWT_EXPIRES_IN=1d
