# Web (build ARG, no exponer secretos con prefijo VITE_)
VITE_API_URL=http://localhost:3000

# API (usa la DB dockerizada del repo, jamás Supabase)
PORT=3000
DATABASE_URL=postgresql://plancity:plancity@db:5432/plancity
JWT_SECRET=cambiar-en-produccion-valor-largo-aleatorio
JWT_EXPIRES_IN=1d

# Postgres local (servicio db + database/Dockerfile)
POSTGRES_USER=plancity
POSTGRES_PASSWORD=plancity
POSTGRES_DB=plancity

# Solo seed manual apps/web (no van al bundle)
SEED_ACCESS_TOKEN=
SEED_ADMIN_EMAIL=admin@examen.com
SEED_ADMIN_PASSWORD=
